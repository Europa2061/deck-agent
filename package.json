{
  "name": "deck-agent",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "description": "Steam Deck 游戏模式中的通用 Pi Agent",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c --forceExit",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1 --port 4313 --strictPort",
    "test": "python3 -m unittest discover -s tests -v",
    "test:frontend": "node --test tests/frontend-*.test.mjs",
    "package": "python3 scripts/package.py",
    "runtime:install": "npm ci --prefix runtime --omit=dev"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.4",
    "@types/node": "22.19.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
